/**
 * Optimuse Web Client — chat UI with live tool visualization and preview rendering.
 * Communicates with the server API at /api/*
 */

class OptimuseWebClient {
  chatContainer: HTMLElement;
  previewContainer: HTMLElement;
  messageInput: HTMLTextAreaElement;
  sendBtn: HTMLButtonElement;
  connectorBar: HTMLElement;
  sessionId = 'web-' + Math.random().toString(36).slice(2, 10);
  isWaiting = false;

  constructor() {
    this.chatContainer = document.getElementById('chat-container')!;
    this.previewContainer = document.getElementById('preview-container')!;
    this.messageInput = document.getElementById('message-input') as HTMLTextAreaElement;
    this.sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
    this.connectorBar = document.getElementById('connector-bar')!;

    this.bindEvents();
    this.loadHealth();
    this.loadConnectors();
  }

  bindEvents() {
    // Send on button click
    this.sendBtn.addEventListener('click', () => this.sendMessage());

    // Send on Enter (but not Shift+Enter)
    this.messageInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (!this.isWaiting) this.sendMessage();
      }
    });

    // Auto-resize textarea
    this.messageInput.addEventListener('input', () => {
      this.messageInput.style.height = 'auto';
      this.messageInput.style.height = Math.min(this.messageInput.scrollHeight, 120) + 'px';
    });
  }

  async loadHealth() {
    try {
      const res = await fetch('/api/health');
      const data = await res.json();
      const meta = document.getElementById('model-meta')!;
      meta.textContent = `model: ${data.model} · mode: ${data.mode} · vault: ${data.workspace}`;
    } catch (e) {
      console.error('health check failed', e);
    }
  }

  async loadConnectors() {
    try {
      const res = await fetch('/api/connectors');
      const connectors = await res.json();
      this.connectorBar.innerHTML = '';
      for (const c of connectors) {
        const pill = document.createElement('span');
        pill.className = `connector-pill${c.connected ? ' connected' : ''}`;
        pill.textContent = `${c.id} ${c.connected ? '🔗' : '⚪'}`;
        this.connectorBar.appendChild(pill);
      }
      if (connectors.length === 0) {
        this.connectorBar.innerHTML = '<span class="connector-pill" style="color: var(--text-muted);">No connectors available</span>';
      }
    } catch (e) {
      console.error('connector load failed', e);
    }
  }

  async sendMessage() {
    const text = this.messageInput.value.trim();
    if (!text || this.isWaiting) return;

    this.isWaiting = true;
    this.sendBtn.disabled = true;
    this.messageInput.value = '';
    this.messageInput.style.height = 'auto';

    // Add user message
    this.addMessage('user', text);

    // Add thinking indicator
    const thinkingEl = this.addThinking();

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, sessionId: this.sessionId }),
      });
      const data = await res.json();

      // Remove thinking indicator
      thinkingEl.remove();

      if (data.error) {
        this.addMessage('assistant', `❌ Error: ${data.error}`);
        return;
      }

      // Add assistant response
      this.addMessage('assistant', data.finalText || '(no response)');

      // Render tool calls and results in preview
      this.renderToolResults(data.toolResults || [], data.toolCalls || []);
      this.renderPreview(data);

    } catch (e) {
      thinkingEl.remove();
      this.addMessage('assistant', `❌ Network error: ${(e as Error).message}`);
    } finally {
      this.isWaiting = false;
      this.sendBtn.disabled = false;
      this.messageInput.focus();
    }
  }

  addMessage(role: 'user' | 'assistant', text: string): HTMLElement {
    const msgDiv = document.createElement('div');
    msgDiv.className = `message message-${role}`;
    msgDiv.textContent = text;
    this.chatContainer.appendChild(msgDiv);
    this.chatContainer.scrollTop = this.chatContainer.scrollHeight;
    return msgDiv;
  }

  addThinking(): HTMLElement {
    const div = document.createElement('div');
    div.className = 'thinking';
    div.innerHTML = `<span>Thinking...</span><div class="thinking-dots"><span class="thinking-dot"></span><span class="thinking-dot"></span><span class="thinking-dot"></span></div>`;
    this.chatContainer.appendChild(div);
    this.chatContainer.scrollTop = this.chatContainer.scrollHeight;
    return div;
  }

  renderToolResults(toolResults: any[], toolCalls: any[]) {
    // Don't add tool results as chat messages — we show them in preview instead
    // But we do log them for debugging
    if (toolResults.length > 0 || toolCalls.length > 0) {
      console.log('Tool calls:', toolCalls);
      console.log('Tool results:', toolResults);
    }
  }

  renderPreview(data: any) {
    const { finalText, toolResults = [], toolCalls = [] } = data;

    if (toolResults.length === 0 && !finalText) {
      this.previewContainer.innerHTML = '<div class="preview-placeholder">📺 No preview available</div>';
      return;
    }

    let html = '';

    // Show tool calls
    if (toolCalls.length > 0) {
      html += '<div class="preview-section"><h3 style="color: var(--text-muted); font-size: 12px; margin-bottom: 8px;">Tool Calls</h3>';
      for (const tc of toolCalls) {
        html += `<div style="padding: 8px; margin-bottom: 8px; background: rgba(59, 130, 246, 0.1); border-radius: 6px; border-left: 3px solid var(--tool-read);">`;
        html += `<div style="font-size: 11px; font-weight: 600; color: var(--tool-read);">${tc.name}</div>`;
        html += `<pre style="font-family: monospace; font-size: 11px; color: var(--text-muted); margin-top: 4px; white-space: pre-wrap;">${JSON.stringify(tc.arguments, null, 2)}</pre>`;
        html += `</div>`;
      }
      html += '</div>';
    }

    // Show tool results
    if (toolResults.length > 0) {
      html += '<div class="preview-section"><h3 style="color: var(--text-muted); font-size: 12px; margin-bottom: 8px;">Tool Results</h3>';
      for (const tr of toolResults) {
        const statusColor = tr.ok ? 'var(--success)' : 'var(--error)';
        const statusText = tr.ok ? '✔' : '✘';
        html += `<div style="padding: 8px; margin-bottom: 8px; background: rgba(255,255,255,0.02); border-radius: 6px; border-left: 3px solid ${statusColor};">`;
        html += `<div style="font-size: 11px; font-weight: 600; color: ${statusColor}; margin-bottom: 4px;">${statusText} ${tr.toolName || 'tool'}</div>`;
        html += `<pre style="font-family: monospace; font-size: 11px; color: var(--text-muted); white-space: pre-wrap; max-height: 200px; overflow-y: auto;">${tr.content || (tr.error ? tr.error : '(empty)')}</pre>`;
        html += `</div>`;
      }
      html += '</div>';
    }

    // Show final text
    if (finalText) {
      html += '<div class="preview-section"><h3 style="color: var(--text-muted); font-size: 12px; margin-bottom: 8px;">Response</h3>';
      html += `<div style="font-size: 13px; line-height: 1.6; color: var(--text);">${this.escapeHtml(finalText)}</div>`;
      html += '</div>';
    }

    this.previewContainer.innerHTML = html;
  }

  escapeHtml(text: string): string {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }
}

// Initialize on DOM load
document.addEventListener('DOMContentLoaded', () => {
  new OptimuseWebClient();
});