/**
 * Optimuse Web Surface — HTTP server with static file serving and API endpoints.
 * Serves the web UI and bridges to the Optimuse core (Agent, Provider, Connectors).
 *
 * Settings flow: Frontend stores settings in localStorage for immediate UX.
 * When settings are saved, the API key is also synced to the server's encrypted file
 * via POST /api/settings. The server uses the synced settings (or env vars) to
 * initialize the provider. Server restart picks up the latest stored settings.
 */

import * as http from 'node:http';
import * as fs from 'node:fs';
import * as path from 'node:path';
import { fileURLToPath } from 'node:url';
import * as os from 'node:os';
import * as crypto from 'node:crypto';
import { Agent } from '../../core/agent.js';
import { OpenAICompatibleProvider } from '../../providers/openai/provider.js';
import { ToolRegistry } from '../../tools/registry.js';
import { fsTools, shellTools } from '../../tools/builtin/index.js';
import { createLinuxHost } from '../../hosts/linux/index.js';
import { ConnectorRegistry } from '../../connectors/registry.js';
import { githubConnector } from '../../connectors/github/index.js';
import type { ChatMessage, ToolCallRequest, ToolResult, PermissionMode } from '../../types/index.js';
import { encodeCredential } from '../../connectors/types.js';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

// Support both src layout (dev via tsx) and dist layout (compiled)
const publicDir = fs.existsSync(path.join(__dirname, 'public'))
  ? path.join(__dirname, 'public')
  : path.join(__dirname, '..', '..', '..', 'src', 'surfaces', 'web', 'public');

// --- Settings Persistence ---
// Encrypted settings file with persistent AES-256-GCM key (stored in 0600 file).
const DATA_DIR = process.env['OPTIMUSE_DATA_DIR'] ?? path.join(os.homedir(), '.optimuse');
const SETTINGS_FILE = path.join(DATA_DIR, 'web-settings.enc');
const SETTINGS_KEY_FILE = path.join(DATA_DIR, 'web-settings.key');

interface ServerSettings {
  apiKey: string;
  baseUrl: string;
  model: string;
  workspace: string;
  mode: PermissionMode;
}

/** Get or create the persistent encryption key for settings. */
async function getSettingsKey(): Promise<Buffer> {
  try {
    return Buffer.from(await fs.promises.readFile(SETTINGS_KEY_FILE, 'utf8'), 'base64');
  } catch {
    const k = crypto.randomBytes(32);
    await fs.promises.mkdir(DATA_DIR, { recursive: true, mode: 0o700 });
    await fs.promises.writeFile(SETTINGS_KEY_FILE, k.toString('base64'), { mode: 0o600 });
    return k;
  }
}

async function decryptSettings(key: Buffer): Promise<ServerSettings | null> {
  try {
    const raw = await fs.promises.readFile(SETTINGS_FILE);
    const iv = raw.subarray(0, 12);
    const tag = raw.subarray(12, 28);
    const body = raw.subarray(28);
    const decipher = crypto.createDecipheriv('aes-256-gcm', key, iv);
    decipher.setAuthTag(tag);
    const plain = Buffer.concat([decipher.update(body), decipher.final()]);
    return JSON.parse(plain.toString('utf8')) as ServerSettings;
  } catch {
    return null;
  }
}

async function encryptSettings(settings: ServerSettings, key: Buffer): Promise<void> {
  const iv = crypto.randomBytes(12);
  const cipher = crypto.createCipheriv('aes-256-gcm', key, iv);
  const body = Buffer.concat([cipher.update(JSON.stringify(settings), 'utf8'), cipher.final()]);
  const tag = cipher.getAuthTag();
  await fs.promises.mkdir(DATA_DIR, { recursive: true, mode: 0o700 });
  const tmp = SETTINGS_FILE + '.tmp';
  await fs.promises.writeFile(tmp, Buffer.concat([iv, tag, body]), { mode: 0o600 });
  await fs.promises.rename(tmp, SETTINGS_FILE);
}

// --- Initialize settings from env or stored file ---
const settingsKey = await getSettingsKey();
const storedSettings = await decryptSettings(settingsKey);

const envApiKey = process.env['OPTIMUSE_API_KEY'] ?? '';
const envBaseUrl = process.env['OPTIMUSE_BASE_URL'] ?? 'https://api.openai.com/v1';
const envModel = process.env['OPTIMUSE_MODEL'] ?? 'gpt-4o-mini';
const envWorkspace = process.env['OPTIMUSE_WORKSPACE'] ?? process.cwd();
const envMode = (process.env['OPTIMUSE_MODE'] ?? 'workspace') as PermissionMode;

const settings: ServerSettings = {
  apiKey: storedSettings?.apiKey || envApiKey,
  baseUrl: storedSettings?.baseUrl || envBaseUrl,
  model: storedSettings?.model || envModel,
  workspace: storedSettings?.workspace || envWorkspace,
  mode: storedSettings?.mode || envMode,
};

if (!settings.apiKey) {
  console.warn('⚠ No OPTIMUSE_API_KEY set — web surface will prompt for API key');
} else {
  console.log(`✅ API key configured (${settings.model})`);
}

// Initialize registries
const registry = new ToolRegistry();
for (const t of [...fsTools(settings.workspace), ...shellTools(settings.workspace)]) registry.register(t);

// Phase 3: Linux host tools (terminal, enhanced fs, system ops)
const linuxHost = await createLinuxHost(settings.workspace);
for (const t of linuxHost.getTools()) registry.register(t);

const connRegistry = await ConnectorRegistry.create();
connRegistry.register(githubConnector);

const provider = new OpenAICompatibleProvider({
  baseUrl: settings.baseUrl,
  apiKey: settings.apiKey,
  model: settings.model,
});

const sessions = new Map<string, ChatMessage[]>();

const MIME_TYPES: Record<string, string> = {
  '.html': 'text/html; charset=utf-8',
  '.js': 'application/javascript; charset=utf-8',
  '.css': 'text/css; charset=utf-8',
  '.json': 'application/json; charset=utf-8',
  '.png': 'image/png',
  '.ico': 'image/x-icon',
  '.svg': 'image/svg+xml',
  '.woff': 'font/woff',
  '.woff2': 'font/woff2',
};

function serveFile(req: http.IncomingMessage, res: http.ServerResponse, filePath: string): void {
  const ext = path.extname(filePath);
  const mime = MIME_TYPES[ext] ?? 'application/octet-stream';

  fs.readFile(filePath, (err, data) => {
    if (err) {
      res.writeHead(404, { 'Content-Type': 'text/plain' });
      res.end('Not found');
      return;
    }
    res.writeHead(200, { 'Content-Type': mime, 'Content-Length': data.length });
    res.end(data);
  });
}

function parseJsonBody(req: http.IncomingMessage): Promise<unknown> {
  return new Promise((resolve, reject) => {
    let body = '';
    req.on('data', (chunk) => { body += chunk; });
    req.on('end', () => {
      try {
        resolve(body ? JSON.parse(body) : {});
      } catch {
        reject(new Error('Invalid JSON'));
      }
    });
    req.on('error', reject);
  });
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url ?? '/', `http://${req.headers.host}`);
  const pathname = url.pathname;

  // CORS headers
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS, DELETE');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization');

  if (req.method === 'OPTIONS') {
    res.writeHead(204);
    res.end();
    return;
  }

  // --- API Routes ---

  // GET /api/health — server status + config info
  if (pathname === '/api/health') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({
      status: 'ok',
      model: settings.model,
      mode: settings.mode,
      workspace: settings.workspace,
      hasApiKey: !!settings.apiKey,
      vault: connRegistry.vaultBackend(),
      host: {
        displayName: linuxHost.descriptor.displayName,
        platform: linuxHost.descriptor.platform,
        privilege: linuxHost.descriptor.privilege,
        isolation: linuxHost.descriptor.isolation,
        capabilities: linuxHost.descriptor.capabilities.map((c) => ({
          id: c.id,
          name: c.displayName,
          available: c.available,
        })),
        onboarding: linuxHost.descriptor.onboardingRequirements.map((r) => ({
          id: r.id,
          title: r.title,
          satisfied: r.satisfied,
        })),
      },
    }));
    return;
  }

  // GET /api/settings — get current server settings (apiKey masked)
  if (pathname === '/api/settings') {
    const masked = {
      ...settings,
      apiKey: settings.apiKey ? '••••••••••••••••' + settings.apiKey.slice(-4) : '',
    };
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify(masked));
    return;
  }

  // POST /api/settings — update server settings (API key stored in encrypted file)
  if (pathname === '/api/settings' && req.method === 'POST') {
    const body = await parseJsonBody(req) as Partial<ServerSettings>;
    const updated: ServerSettings = {
      apiKey: body.apiKey ?? settings.apiKey,
      baseUrl: body.baseUrl ?? settings.baseUrl,
      model: body.model ?? settings.model,
      workspace: body.workspace ?? settings.workspace,
      mode: body.mode ?? settings.mode,
    };
    await encryptSettings(updated, settingsKey);
    Object.assign(settings, updated);
    // Reinitialize provider with new settings at runtime
    provider.updateConfig({
      baseUrl: updated.baseUrl,
      apiKey: updated.apiKey,
      model: updated.model,
    });
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ ok: true }));
    return;
  }

  // DELETE /api/settings/apikey — remove API key from server
  if (pathname === '/api/settings/apikey' && req.method === 'DELETE') {
    settings.apiKey = '';
    await encryptSettings(settings, settingsKey);
    provider.updateConfig({ apiKey: '' });
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ ok: true }));
    return;
  }

  // GET /api/connectors — list connectors with status
  if (pathname === '/api/connectors') {
    const connectors = connRegistry.list();
    const status = await Promise.all(connectors.map(async (c) => ({
      id: c.id,
      name: c.name,
      description: c.description,
      connected: await connRegistry.hasCredential(c.id),
    })));
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify(status));
    return;
  }

  // POST /api/connectors/connect — connect a connector
  if (pathname === '/api/connectors/connect' && req.method === 'POST') {
    const body = await parseJsonBody(req) as { connectorId: string; token: string };
    const connector = connRegistry.get(body.connectorId);
    if (!connector) {
      res.writeHead(404, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: 'connector not found' }));
      return;
    }
    const method = connector.authMethods[0];
    if (!method) {
      res.writeHead(400, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: 'no auth method' }));
      return;
    }
    const cred = encodeCredential(method, { token: body.token });
    await connRegistry.setCredential(body.connectorId, cred);
    const result = await connRegistry.validate(body.connectorId);
    if (result.ok) {
      const freshTools = await connRegistry.getTools();
      for (const t of freshTools) {
        if (!registry.get(t.name)) registry.register(t);
      }
    }
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ ok: result.ok, account: result.account, error: result.error }));
    return;
  }

  // POST /api/connectors/disconnect — disconnect a connector
  if (pathname === '/api/connectors/disconnect' && req.method === 'POST') {
    const body = await parseJsonBody(req) as { connectorId: string };
    await connRegistry.deleteCredential(body.connectorId);
    for (const t of registry.list()) {
      if (t.name.startsWith(`${body.connectorId}_`)) registry.unregister(t.name);
    }
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ ok: true }));
    return;
  }

  // GET /api/tools — list all available tools
  if (pathname === '/api/tools') {
    const tools = registry.list().map((t) => ({
      name: t.name,
      description: t.description,
      effect: t.effect,
      parameters: t.parameters,
    }));
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify(tools));
    return;
  }

  // POST /api/chat — chat endpoint with session management
  if (pathname === '/api/chat' && req.method === 'POST') {
    const body = (await parseJsonBody(req)) as {
      message: string;
      sessionId?: string;
    };
    const sessionId = body.sessionId ?? 'default';
    const history = sessions.get(sessionId) ?? [];

    const agent = new Agent(provider, registry, {
      permissionMode: settings.mode,
      workspaceRoot: settings.workspace,
      maxSteps: 16,
      onToken: () => {},
      onToolCall: (_c: ToolCallRequest) => {},
      onToolResult: (_c: ToolCallRequest, _r: ToolResult) => {},
    });

    const result = await agent.run(body.message, history);

    history.push({ role: 'user', content: body.message });
    history.push({ role: 'assistant', content: result.finalText });
    sessions.set(sessionId, history);

    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({
      finalText: result.finalText,
      steps: result.steps,
      toolCalls: result.toolCalls,
      toolResults: result.toolResults,
      error: result.error,
    }));
    return;
  }

  // Static file serving
  let filePath: string;
  if (pathname === '/' || pathname === '/index.html') {
    filePath = path.join(publicDir, 'index.html');
  } else {
    filePath = path.join(publicDir, pathname);
  }

  // Prevent path traversal
  const resolved = path.resolve(filePath);
  if (!resolved.startsWith(path.resolve(publicDir))) {
    res.writeHead(403, { 'Content-Type': 'text/plain' });
    res.end('Forbidden');
    return;
  }

  serveFile(req, res, resolved);
});

const port = process.env['OPTIMUSE_WEB_PORT'] ?? 3000;
server.listen(port, () => {
  console.log(`Optimuse Web Surface running on http://localhost:${port}`);
  console.log(`Model: ${settings.model} | Mode: ${settings.mode} | Workspace: ${settings.workspace}`);
  console.log(`API Key: ${settings.apiKey ? 'configured ✅' : 'NOT SET ⚠️ (use settings modal)'}`);
  console.log(`Vault: ${connRegistry.vaultBackend()}`);
});