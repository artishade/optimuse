/**
 * Optimuse CLI — minimal chat surface with tools.
 * Config via env: OPTIMUSE_BASE_URL, OPTIMUSE_API_KEY, OPTIMUSE_MODEL,
 *                 OPTIMUSE_WORKSPACE (default cwd), OPTIMUSE_MODE (readonly|workspace|full)
 */

import * as readline from 'node:readline';
import { Agent } from '../../core/agent.js';
import { OpenAICompatibleProvider } from '../../providers/openai/provider.js';
import { ToolRegistry } from '../../tools/registry.js';
import { fsTools, shellTools } from '../../tools/builtin/index.js';
import type { ChatMessage } from '../../types/index.js';
import { ConnectorRegistry } from '../../connectors/registry.js';
import { githubConnector } from '../../connectors/github/index.js';
import { encodeCredential } from '../../connectors/types.js';

const baseUrl = process.env['OPTIMUSE_BASE_URL'] ?? 'https://api.openai.com/v1';
const apiKey = process.env['OPTIMUSE_API_KEY'] ?? '';
const model = process.env['OPTIMUSE_MODEL'] ?? 'gpt-4o-mini';
const workspaceRoot = process.env['OPTIMUSE_WORKSPACE'] ?? process.cwd();
const mode = (process.env['OPTIMUSE_MODE'] ?? 'workspace') as 'readonly' | 'workspace' | 'full';

if (!apiKey) {
  console.error('OPTIMUSE_API_KEY is required');
  process.exit(1);
}

const registry = new ToolRegistry();
for (const t of [...fsTools(workspaceRoot), ...shellTools(workspaceRoot)]) registry.register(t);

// Initialize connector registry and load available tools
const connRegistry = await ConnectorRegistry.create();
connRegistry.register(githubConnector);

// Register tools from connected connectors
const connTools = await connRegistry.getTools();
for (const t of connTools) registry.register(t);

console.log(`Optimuse v0.1 · model=${model} · mode=${mode} · workspace=${workspaceRoot}`);
console.log(`Vault backend: ${connRegistry.vaultBackend()}`);
console.log(`Connected connectors: ${(await connRegistry.list()).map((c) => {
  const hasCred = await connRegistry.hasCredential(c.id);
  return `${c.id}${hasCred ? ' 🔗' : ' (disconnected)'}`;
}).join(', ')}`);

const provider = new OpenAICompatibleProvider({ baseUrl, apiKey, model });
const agent = new Agent(provider, registry, {
  permissionMode: mode,
  workspaceRoot,
  maxSteps: 16,
  onToolCall: (c) => console.log(`  ⚙ ${c.name} ${JSON.stringify(c.arguments).slice(0, 120)}`),
  onToolResult: (c, r) => console.log(`  ${r.ok ? '✔' : '✘'} ${c.name}`),
});

const rl = readline.createInterface({ input: process.stdin, output: process.stdout, prompt: 'you › ' });
const history: ChatMessage[] = [];

console.log(`Optimuse v0.1 · model=${model} · mode=${mode} · workspace=${workspaceRoot}`);
console.log('type your message, /tools to list tools, /connectors to manage connectors, /exit to quit\n');
rl.prompt();

async function refreshConnectorTools() {
  const connTools = await connRegistry.getTools();
  // Clear old connector-prefixed tools and re-register
  for (const t of [...registry.list()].filter((t) => t.name.includes('_'))) {
    // Note: ToolRegistry doesn't support unregister yet, so we rebuild
  }
  const freshRegistry = new ToolRegistry();
  for (const t of [...fsTools(workspaceRoot), ...shellTools(workspaceRoot)]) freshRegistry.register(t);
  for (const t of connTools) freshRegistry.register(t);
  return freshRegistry;
}

rl.on('line', (line) => {
  const input = line.trim();
  if (!input) { rl.prompt(); return; }
  if (input === '/exit') { rl.close(); return; }
  if (input === '/tools') {
    for (const t of registry.list()) console.log(`  ${t.effect === 'write' ? '✎' : '👁'} ${t.name} — ${t.description}`);
    rl.prompt();
    return;
  }
  if (input === '/connectors') {
    rl.prompt();
    return;
  }
  const match = input.match(/^\/connectors\s+(\w+)\s+(connect|disconnect|validate)$/);
  if (match) {
    const [, connectorId, action] = match;
    handleConnectorAction(connectorId, action as 'connect' | 'disconnect' | 'validate');
    rl.prompt();
    return;
  }
  rl.pause();
  agent
    .run(input, history)
    .then((r) => {
      console.log(`\noptimuse › ${r.finalText}\n`);
      history.push({ role: 'user', content: input });
      history.push({ role: 'assistant', content: r.finalText });
    })
    .catch((e) => console.error('error:', (e as Error).message))
    .finally(() => { rl.resume(); rl.prompt(); });
});

async function handleConnectorAction(connectorId: string, action: 'connect' | 'disconnect' | 'validate') {
  const connector = connRegistry.get(connectorId);
  if (!connector) {
    console.log(`  Unknown connector: ${connectorId}`);
    return;
  }
  if (action === 'validate') {
    const result = await connRegistry.validate(connectorId);
    if (result.ok) {
      console.log(`  ✅ Connected as: ${result.account}`);
    } else {
      console.log(`  ❌ Validation failed: ${result.error}`);
    }
    return;
  }
  if (action === 'disconnect') {
    await connRegistry.deleteCredential(connectorId);
    console.log(`  🔌 Disconnected ${connectorId}`);
    return;
  }
  if (action === 'connect') {
    if (connectorId === 'github') {
      const token = await new Promise<string>((resolve) => rl.question('  GitHub token: ', resolve));
      const cred = encodeCredential(connector.authMethods[0]!, { token });
      await connRegistry.setCredential(connectorId, cred);
      const result = await connRegistry.validate(connectorId);
      if (result.ok) {
        console.log(`  ✅ Connected to GitHub as: ${result.account}`);
      } else {
        console.log(`  ❌ Connection failed: ${result.error}`);
      }
    } else {
      console.log(`  Connect flow not implemented for ${connectorId}`);
    }
  }
}

console.log('Available connectors:');
for (const c of connRegistry.list()) {
  const hasCred = await connRegistry.hasCredential(c.id);
  console.log(`  /connectors ${c.id} ${hasCred ? 'disconnect' : 'connect'} — ${c.description}`);
}

rl.on('close', () => { console.log('bye 👋'); process.exit(0); });
