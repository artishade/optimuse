<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Optimuse</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" href="data:, " />
</head>
<body>
  <div class="app">
    <!-- Left: Interaction Panel (Koro/Chat) -->
    <div class="panel interaction-panel">
      <div class="panel-header">
        <span class="panel-title">Optimuse</span>
        <span class="panel-meta" id="model-meta">model: gpt-4o-mini</span>
      </div>
      <div class="chat-container" id="chat-container">
        <div class="chat-welcome">
          <div class="welcome-message">👋 Welcome to Optimuse</div>
          <div class="welcome-hint">Type a message below to start chatting with your AI assistant.</div>
        </div>
      </div>
      <div class="input-area">
        <div class="input-row">
          <textarea id="message-input" placeholder="Ask me anything..." rows="1" autoResize></textarea>
          <button id="send-btn" class="send-btn">➤</button>
        </div>
        <div class="connector-bar" id="connector-bar"></div>
      </div>
    </div>

    <!-- Right: Preview Panel -->
    <div class="panel preview-panel">
      <div class="panel-header">
        <span class="panel-title">Preview</span>
      </div>
      <div class="preview-container" id="preview-container">
        <div class="preview-placeholder">📺 Preview will appear here</div>
      </div>
    </div>
  </div>
  <script src="/app.js"></script>
</body>
</html>